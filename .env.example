# Copy to .env (cp .env.example .env) and adjust if needed.
# Paths are relative to the repository root.
AFTERSIGHT_DATA_DIR=data
AFTERSIGHT_ARTIFACTS_DIR=artifacts
AFTERSIGHT_OUTPUTS_DIR=outputs
# Origin of the Vite dev server allowed by CORS
AFTERSIGHT_FRONTEND_ORIGIN=http://localhost:5200
# Config files (repo-relative); the end-to-end check points these at a synthetic deployment
AFTERSIGHT_EVENTS_CONFIG=config/events.yaml
AFTERSIGHT_TRAINING_CONFIG=config/training.yaml
